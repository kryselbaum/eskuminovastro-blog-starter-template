---
import { WHATSAPP_URL } from "../consts";
import { ui } from "../data/ui";
import Arrow from "./Arrow.astro";

interface Props {
	title?: string;
	text?: string;
}
const { title = ui.ctaTitle, text = ui.ctaText } = Astro.props;
---

<section class="section section--dark cta-band">
	<div class="container">
		<h2>{title}</h2>
		<p class="lead">{text}</p>
		<div class="btn-row">
			<a class="btn btn--primary" href={WHATSAPP_URL}>{ui.ctaPrimary} <Arrow /></a>
			<a class="btn btn--ghost" href={ui.contactHref}>{ui.ctaSecondary}</a>
		</div>
	</div>
</section>

<style>
	.cta-band h2 {
		font-size: clamp(2.4rem, 1.4rem + 4vw, 4.6rem);
		max-width: 16ch;
	}
</style>
