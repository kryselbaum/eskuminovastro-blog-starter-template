---
import "../styles/global.css";
import { LANG, SITE_URL, SITE_NAME, CONTACT_EMAIL, ALT_LANG, ALT_PATHS } from "../consts";

interface Props {
	title: string;
	description: string;
	image?: string;
	schema?: object[];
}

const { title, description, image = "/img/og.jpg", schema = [] } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalURL = new URL(path, SITE_URL);
const imageURL = new URL(image, SITE_URL);
const altPath = ALT_PATHS[path];
const altURL = altPath ? new URL(altPath, ALT_LANG.site).toString() : null;
const locale = LANG === "es" ? "es_ES" : "en_GB";

const orgSchema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: SITE_NAME,
	url: SITE_URL,
	image: imageURL.toString(),
	email: CONTACT_EMAIL,
	telephone: "+34637235634",
	priceRange: "€€€",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Avilés",
		addressRegion: "Asturias",
		addressCountry: "ES",
	},
	areaServed: ["ES", "EU"],
	knowsLanguage: ["es", "en", "ru"],
	founder: { "@type": "Person", name: "Víctor Kuminov" },
	sameAs: [ALT_LANG.site],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#faf9f7" />
<link rel="preload" href="/fonts/instrument-serif-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={LANG} href={canonicalURL} />
{altURL && <link rel="alternate" hreflang={ALT_LANG.code} href={altURL} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={locale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
