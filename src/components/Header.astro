---
import { SITE_NAME, ALT_LANG, ALT_PATHS, WHATSAPP_URL } from "../consts";
import { ui } from "../data/ui";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const section = "/" + (path.split("/")[1] ?? "");
const altHref = new URL(ALT_PATHS[path] ?? "/", ALT_LANG.site).toString();
---

<a class="skip" href="#main">{ui.skip}</a>
<header class="site-header">
	<div class="container bar">
		<a class="brand" href="/" aria-label={SITE_NAME}>
			<span class="brand-name">{SITE_NAME}</span>
			<span class="brand-sub">{ui.brandSub}</span>
		</a>
		<nav class="nav" id="site-nav" aria-label={ui.menu}>
			<ul>
				{ui.nav.map((l) => (
					<li><a href={l.href} aria-current={section === l.href ? "page" : undefined}>{l.label}</a></li>
				))}
			</ul>
			<div class="nav-extra">
				<a class="lang" href={altHref} hreflang={ALT_LANG.code} lang={ALT_LANG.code} title={ui.langSwitch}>{ALT_LANG.label}</a>
				<a class="btn btn--primary nav-cta" href={ui.contactHref}>{ui.navCta}</a>
				<a class="btn btn--ghost nav-wa" href={WHATSAPP_URL}>{ui.whatsapp}</a>
			</div>
		</nav>
		<button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false">
			<span class="sr-only">{ui.menu}</span>
			<span class="burger" aria-hidden="true"></span>
		</button>
	</div>
</header>

<script>
	const btn = document.querySelector<HTMLButtonElement>(".menu-btn");
	const header = document.querySelector(".site-header");
	const setOpen = (open: boolean) => {
		header?.classList.toggle("is-open", open);
		btn?.setAttribute("aria-expanded", String(open));
		document.documentElement.style.overflow = open ? "hidden" : "";
	};
	btn?.addEventListener("click", () => setOpen(!header?.classList.contains("is-open")));
	document.addEventListener("keydown", (e) => e.key === "Escape" && setOpen(false));
	document.querySelectorAll(".nav a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(250, 249, 247, 0.86);
		backdrop-filter: saturate(1.4) blur(12px);
		-webkit-backdrop-filter: saturate(1.4) blur(12px);
		border-bottom: 1px solid var(--line);
	}
	/* backdrop-filter crea un bloque contenedor: se quita al abrir para que el menú fijo ocupe la pantalla */
	.site-header.is-open {
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		background: var(--paper);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 68px;
	}
	.brand {
		display: flex;
		flex-direction: column;
		line-height: 1.05;
		text-decoration: none;
		position: relative;
		z-index: 2;
	}
	.brand-name {
		font-family: var(--font-display);
		font-size: 1.45rem;
		color: var(--ink);
		letter-spacing: -0.01em;
	}
	.brand-sub {
		font-size: 0.66rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		margin-top: 3px;
	}
	.nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		gap: 1.8rem;
	}
	.nav ul a {
		color: var(--ink-2);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		padding: 0.4rem 0;
		background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
		transition: background-size 0.25s var(--ease), color 0.2s;
	}
	.nav ul a:hover,
	.nav ul a[aria-current="page"] {
		color: var(--ink);
		background-size: 100% 1px;
	}
	.nav {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	.nav-extra {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.lang {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--muted);
		text-decoration: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 0.3rem 0.6rem;
	}
	.lang:hover {
		color: var(--ink);
		border-color: var(--ink);
	}
	.nav-cta {
		min-height: 42px;
		padding: 0.6rem 1.1rem;
		font-size: 0.9rem;
	}
	.nav-wa {
		display: none;
	}
	.menu-btn {
		display: none;
		position: relative;
		z-index: 2;
		width: 44px;
		height: 44px;
		border: 0;
		background: transparent;
		cursor: pointer;
		margin-right: -10px;
	}
	.burger,
	.burger::before,
	.burger::after {
		position: absolute;
		left: 11px;
		width: 22px;
		height: 1.5px;
		background: var(--ink);
		transition: transform 0.25s var(--ease), top 0.25s var(--ease), opacity 0.2s;
	}
	.burger {
		top: 21px;
	}
	.burger::before,
	.burger::after {
		content: "";
		left: 0;
	}
	.burger::before {
		top: -7px;
	}
	.burger::after {
		top: 7px;
	}
	.is-open .burger {
		background: transparent;
	}
	.is-open .burger::before {
		top: 0;
		transform: rotate(45deg);
	}
	.is-open .burger::after {
		top: 0;
		transform: rotate(-45deg);
	}

	@media (max-width: 1020px) {
		.menu-btn {
			display: block;
		}
		.nav {
			position: fixed;
			inset: 0;
			z-index: 1;
			flex-direction: column;
			align-items: stretch;
			justify-content: space-between;
			gap: 2rem;
			padding: 100px var(--gutter) calc(2rem + env(safe-area-inset-bottom));
			background: var(--paper);
			visibility: hidden;
			opacity: 0;
			transform: translateY(-8px);
			transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0s 0.25s;
		}
		.is-open .nav {
			visibility: visible;
			opacity: 1;
			transform: none;
			transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
		}
		.nav ul {
			flex-direction: column;
			gap: 0;
		}
		.nav ul li {
			border-bottom: 1px solid var(--line);
		}
		.nav ul a {
			display: block;
			padding: 0.9rem 0;
			font-family: var(--font-display);
			font-size: 2.2rem;
			font-weight: 400;
			color: var(--ink);
			background: none;
		}
		.nav-extra {
			flex-wrap: wrap;
		}
		.nav-cta,
		.nav-wa {
			display: inline-flex;
			flex: 1 1 200px;
			min-height: 52px;
		}
		.lang {
			order: 3;
		}
	}
</style>
