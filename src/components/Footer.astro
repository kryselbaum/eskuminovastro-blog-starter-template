---
import { SITE_NAME, CONTACT_EMAIL, CONTACT_CITY, WHATSAPP_URL, TELEGRAM_URL, ALT_LANG, ALT_PATHS } from "../consts";
import { ui } from "../data/ui";
import { services } from "../data/services";

const year = new Date().getFullYear();
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const altHref = new URL(ALT_PATHS[path] ?? "/", ALT_LANG.site).toString();
---

<footer class="site-footer">
	<div class="container">
		<div class="foot-top">
			<div class="foot-brand">
				<p class="foot-name">{SITE_NAME}</p>
				<p>{ui.footerTagline}</p>
				<p class="speed small" id="speed" hidden></p>
			</div>
			<div>
				<p class="foot-title">{ui.footerServices}</p>
				<ul>{services.map((s) => <li><a href={`/${s.slug}`}>{s.name}</a></li>)}</ul>
			</div>
			<div>
				<p class="foot-title">{ui.footerStudio}</p>
				<ul>{ui.footerStudioLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
				<p class="foot-title" style="margin-top:1.5rem">{ui.footerContact}</p>
				<ul>
					<li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
					<li><a href={WHATSAPP_URL}>WhatsApp</a> · <a href={TELEGRAM_URL}>Telegram</a></li>
					<li>{CONTACT_CITY}</li>
				</ul>
			</div>
		</div>
		<div class="foot-bottom small">
			<p>&copy; {year} {SITE_NAME}</p>
			<ul>
				{ui.legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
				<li><a href={altHref} hreflang={ALT_LANG.code} lang={ALT_LANG.code}>{ALT_LANG.name}</a></li>
			</ul>
		</div>
	</div>
</footer>

<a class="wa-float" href={WHATSAPP_URL} aria-label={ui.whatsappFloat}>
	<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm5.8 14.03c-.24.68-1.42 1.3-1.95 1.34-.5.05-.97.23-3.27-.68-2.77-1.09-4.52-3.92-4.66-4.1-.13-.18-1.11-1.48-1.11-2.82 0-1.34.7-2 .95-2.27.25-.27.54-.34.72-.34h.52c.17 0 .4-.06.62.47.24.56.79 1.92.86 2.06.07.14.11.3.02.48-.09.18-.14.3-.27.46-.14.16-.29.36-.41.48-.14.14-.28.29-.12.56.16.27.71 1.17 1.52 1.9 1.05.93 1.93 1.22 2.2 1.36.27.14.43.11.59-.07.16-.18.68-.79.86-1.07.18-.27.36-.23.61-.14.25.09 1.59.75 1.86.89.27.14.45.2.52.32.07.11.07.66-.17 1.33Z"/></svg>
</a>

<script define:vars={{ tpl: ui.speed("X") }}>
	addEventListener("load", () => {
		setTimeout(() => {
			const nav = performance.getEntriesByType("navigation")[0];
			const el = document.getElementById("speed");
			if (!nav || !el || !nav.loadEventEnd) return;
			const s = (nav.loadEventEnd / 1000).toFixed(2).replace(".", document.documentElement.lang === "es" ? "," : ".");
			el.textContent = tpl.replace("X", s);
			el.hidden = false;
		}, 0);
	});
</script>

<style>
	.site-footer {
		background: var(--ink);
		color: #a9a9b1;
		padding: var(--s6) 0 var(--s3);
		font-size: 0.95rem;
	}
	.site-footer a {
		color: #d8d8de;
		text-decoration: none;
	}
	.site-footer a:hover {
		color: #fff;
		text-decoration: underline;
	}
	.foot-top {
		display: grid;
		gap: var(--s5);
	}
	@media (min-width: 860px) {
		.foot-top {
			grid-template-columns: 1.3fr 1fr 1fr;
		}
	}
	.foot-name {
		font-family: var(--font-display);
		font-size: 2rem;
		color: var(--on-dark);
		margin-bottom: 0.4rem;
	}
	.foot-brand p {
		max-width: 34ch;
	}
	.speed {
		margin-top: var(--s3);
		color: var(--on-dark-muted);
	}
	.foot-title {
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #7d7d86;
		margin-bottom: 0.8rem;
	}
	.site-footer ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.45rem;
	}
	.foot-bottom {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		margin-top: var(--s6);
		padding-top: var(--s3);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}
	.foot-bottom p {
		margin: 0;
	}
	.foot-bottom ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.4rem;
	}
	.wa-float {
		position: fixed;
		right: max(16px, env(safe-area-inset-right));
		bottom: max(16px, env(safe-area-inset-bottom));
		z-index: 40;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--wa);
		color: #0b3d23;
		box-shadow: 0 10px 30px -10px rgba(16, 16, 20, 0.45);
		transition: transform 0.2s var(--ease);
	}
	.wa-float:hover {
		transform: translateY(-2px);
		color: #0b3d23;
	}
	.wa-float svg {
		width: 26px;
		height: 26px;
	}
</style>
