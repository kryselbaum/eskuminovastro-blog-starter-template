---
import type { Service } from "../data/services";
import { ui } from "../data/ui";

interface Props {
	service: Service;
	num?: string;
	showPrice?: boolean;
}
const { service: s, num, showPrice = true } = Astro.props;
---

<a class="card" href={`/${s.slug}`}>
	{num && <span class="card-num">{num}</span>}
	{s.badge && <span class={`badge badge--${s.badge}`}>{ui.status[s.badge]}</span>}
	<h3>{s.name}</h3>
	<p>{s.short}</p>
	<div class="card-foot">
		{showPrice && <span class="price">{s.price.replace(/ (€)/g, "\u00a0$1")}</span>}
		<span class="link-arrow">{ui.more}</span>
	</div>
</a>
