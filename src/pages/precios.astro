---
import Page from "../layouts/Page.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";

const rows = [
	{ name: "Auditoría estratégica", href: "/rescate", what: "Técnica, diseño y conversión de tu web, tienda o app. Informe y videollamada de 60 min.", price: "450 €", time: "3-5 días", note: "Se descuenta entera si me encargas el proyecto" },
	{ name: "Landing ultrarrápida", href: "/landings", what: "Página de venta a medida.", price: "desde 2.900 €", time: "2-3 semanas", note: "Típico: 2.900-6.000 €" },
	{ name: "Web corporativa", href: "/landings", what: "Web de empresa de varias páginas.", price: "desde 4.900 €", time: "3-5 semanas", note: "Típico: 4.900-9.000 €" },
	{ name: "Tienda online", href: "/tiendas-online", what: "Tienda ligera y rápida que te pertenece.", price: "desde 7.500 €", time: "4-8 semanas", note: "Típico: 7.500-18.000 €" },
	{ name: "De alquiler a tienda propia", href: "/cambio-de-plataforma", what: "Mudanza de tu tienda sin perder posicionamiento.", price: "presupuesto cerrado", time: "según catálogo", note: "Tras la auditoría" },
	{ name: "App iOS y Android", href: "/apps", what: "Primera app con una sola base de código.", price: "desde 3.000 €", time: "desde 4 semanas", note: "Típico: 3.000-12.000 €" },
	{ name: "App con servidor e integraciones", href: "/apps", what: "Producto completo.", price: "a medida", time: "desde 2 meses", note: "Desde 12.000 €" },
	{ name: "Rescate de proyectos", href: "/rescate", what: "Web o tienda que no vende o se quedó a medias.", price: "desde 2.500 €", time: "según caso", note: "Típico: 2.500-8.000 €" },
	{ name: "IA para tu negocio", href: "/ia", what: "Consultoría e implantación: asistente, venta por chat, automatizaciones.", price: "75 €/h", time: "", note: "Implantación con presupuesto cerrado" },
	{ name: "Carta QR y pedidos en mesa", href: "/hosteleria", what: "Para sidrerías, restaurantes y bares.", price: "a medida", time: "", note: "Demo disponible" },
	{ name: "Trabajos puntuales", href: "/mantenimiento", what: "Arreglos y cambios concretos.", price: "90 €/h", time: "", note: "Bono desde 5 horas" },
];

const plans = [
	{ name: "Care", price: "490 €", text: "Tu web siempre al día: actualizaciones, seguridad, copias, soporte prioritario y hasta 3 horas de cambios cada mes." },
	{ name: "Growth", price: "950 €", text: "Todo lo de Care más mejora continua: experimentos de conversión, SEO técnico, contenidos y un informe mensual con datos, no con humo.", featured: true },
	{ name: "Partner", price: "1.900 €", text: "Tu equipo digital externo: prioridad absoluta, bolsa de horas de desarrollo y estrategia trimestral." },
];

const faq = [
	{ q: "¿Por qué no publicas un precio exacto?", a: "Porque dos tiendas nunca son iguales. Publico el punto de partida y la horquilla típica. El precio exacto te lo doy por escrito antes de empezar, y no cambia por el camino." },
	{ q: "¿Cómo se paga?", a: "50% al empezar y 50% al lanzar. En proyectos de más de 10.000 €, por hitos: 40/40/20." },
	{ q: "¿Qué pasa si no quedo satisfecho?", a: "Lo rehago o te devuelvo el dinero. Trabajo por reputación, no por facturar de más." },
	{ q: "¿Hay costes mensuales obligatorios?", a: "Solo el dominio y el alojamiento, que en una web ligera cuestan poco. El mantenimiento es opcional y sin permanencia." },
];
---

<Page
	title="Precios · Víctor Kuminov"
	description="Precios claros de nivel senior: landing desde 2.900 €, tienda online desde 7.500 €, app desde 3.000 €, auditoría 450 €, mantenimiento desde 490 €/mes. Garantía real."
>
	<section class="hero hero--page">
		<div class="container">
			<p class="eyebrow">Precios</p>
			<h1>Precios claros, nivel senior</h1>
			<p class="lead">
				No soy la opción más barata de España. Soy la que no tendrás que pagar dos veces. Sabes el
				precio y el plazo antes de empezar, y no cambian por el camino.
			</p>
		</div>
	</section>

	<section class="section section--tight">
		<div class="container">
			<table class="ptable">
				<thead>
					<tr><th>Servicio</th><th>Precio</th><th>Plazo</th><th>Detalle</th></tr>
				</thead>
				<tbody>
					{rows.map((r) => (
						<tr>
							<td><a href={r.href}>{r.name}</a><br /><span class="muted small">{r.what}</span></td>
							<td class="p">{r.price.replace(/ (€)/g, " $1")}</td>
							<td>{r.time}</td>
							<td class="muted small">{r.note}</td>
						</tr>
					))}
				</tbody>
			</table>
			<p class="muted small" style="margin-top:1rem">Todos los precios + IVA.</p>
		</div>
	</section>

	<section class="section section--alt">
		<div class="container">
			<div class="section-head">
				<p class="eyebrow">Después del lanzamiento</p>
				<h2>Mantenimiento mensual</h2>
				<p>Sin permanencia. Si sigues conmigo, es porque el trabajo te sirve, no por un contrato.</p>
			</div>
			<div class="grid grid--3">
				{plans.map((p) => (
					<div class:list={["card", "plan", { "plan--featured": p.featured }]}>
						{p.featured && <span class="badge">El más elegido</span>}
						<h3>{p.name}</h3>
						<p class="price">{p.price.replace(" €", " €")}<small>/mes</small></p>
						<p>{p.text}</p>
					</div>
				))}
			</div>
			<p class="muted" style="margin-top:1.5rem">
				Módulo de visibilidad en IA: 100-150 €/mes. <a href="/seo-visibilidad-ia">Qué es</a>
			</p>
		</div>
	</section>

	<section class="section section--dark">
		<div class="container split">
			<p class="eyebrow">Garantía</p>
			<p class="callout">Si no quedas satisfecho con el resultado, lo rehago o te devuelvo tu dinero. Así de claro.</p>
		</div>
	</section>

	<section class="section">
		<div class="container split">
			<h2>Preguntas sobre el precio</h2>
			<Faq items={faq} />
		</div>
	</section>

	<CtaBand />
</Page>
