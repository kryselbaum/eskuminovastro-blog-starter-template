---
import Page from "../layouts/Page.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { services, groups, extras, type Group } from "../data/services";

const order: Group[] = ["build", "ai", "sector", "grow"];
---

<Page
	title="Servicios · Víctor Kuminov"
	description="Landings, webs corporativas, tiendas online propias, apps iOS y Android, rescate de proyectos, IA para negocios, carta QR para hostelería, SEO y visibilidad en IA, mantenimiento."
>
	<section class="hero hero--page">
		<div class="container">
			<p class="eyebrow">Servicios</p>
			<h1>Qué hago por tu negocio</h1>
			<p class="lead">
				No te vendo tecnología. Te vendo un negocio que funciona online. Y te digo con sinceridad
				qué necesitas y qué no, aunque no me convenga.
			</p>
		</div>
	</section>

	{order.map((g, i) => (
		<section class:list={["section", "section--tight", { "section--alt": i % 2 === 0 }]}>
			<div class="container">
				<div class="section-head">
					<h2>{groups[g].title}</h2>
					<p>{groups[g].text}</p>
				</div>
				<div class="grid grid--3">
					{services.filter((s) => s.group === g).map((s) => <ServiceCard service={s} />)}
				</div>
			</div>
		</section>
	))}

	<section class="section">
		<div class="container">
			<div class="section-head">
				<h2>Y además</h2>
				<p>Trabajos más pequeños que también hago, sueltos o dentro del mantenimiento.</p>
			</div>
			<div class="grid grid--4">
				{extras.map((e) => (
					<div class="card card--plain">
						<h3>{e.title}</h3>
						<p>{e.text}</p>
					</div>
				))}
			</div>
			<p style="margin-top:2rem"><a class="link-arrow" href="/plataforma">Todo lo que incluye cada tienda, con su estado real</a></p>
		</div>
	</section>

	<CtaBand title="¿No sabes por dónde empezar?" text="Cuéntame tu caso y te digo qué haría yo. Si lo que necesitas es más pequeño de lo que creías, también te lo digo." />
</Page>
